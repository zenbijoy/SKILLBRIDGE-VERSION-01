# -----------------------------------------------------------------------------
# SKILLBRIDGE Root Environment Configuration Example
# SAFE REFERENCE ONLY — NEVER COMMIT REAL SECRETS OR CREDENTIALS
# -----------------------------------------------------------------------------

# Backend API Configuration
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug
API_VERSION=v1
WEB_ORIGINS=http://localhost:8081,http://localhost:5173

# Supabase Auth & Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here_minimum_10_chars
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here_minimum_10_chars

# Error & Crash Telemetry (Sentry)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=skillbridge@3.0.0
SENTRY_TRACES_SAMPLE_RATE=0

# Real-Time Video & WebRTC (LiveKit Cloud)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# WebRTC & Cloudflare TURN Settings
P2P_CALLS_ENABLED=true
CLOUDFLARE_TURN_ENABLED=false
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
TURN_CREDENTIAL_TTL_SECONDS=3600
CALL_RING_TIMEOUT_SECONDS=40
CALL_MAX_RECONNECT_ATTEMPTS=3

# Redis Cache / Presence
REDIS_URL=
REDIS_REQUIRED=false

# Push Notifications
EXPO_PUSH_ACCESS_TOKEN=

# AI Assistant Integration
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=

# Admin Bootstrap (First-time deployment)
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_TEMP_PASSWORD=
ADMIN_BOOTSTRAP_EXPIRES_AT=
ADMIN_REQUIRE_MFA=true
ADMIN_APP_URL=http://localhost:5173

# Frontend (Expo Mobile & Web)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_SENTRY_DSN=

# Admin (Vite Web Console)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_API_URL=http://localhost:4000/api/v1
VITE_SENTRY_DSN=
