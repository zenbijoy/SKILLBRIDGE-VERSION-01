# -----------------------------------------------------------------------------
# SkillBridge Backend Environment Example
# DO NOT ADD REAL SECRETS HERE. 
# Copy to `.env` and fill in the values.
# -----------------------------------------------------------------------------

# --- CORE (Required) ---
# Your Supabase Project URL (e.g., https://xyz.supabase.co or http://127.0.0.1:54321)
SUPABASE_URL="http://127.0.0.1:54321"

# The anonymous public key
SUPABASE_ANON_KEY="your_anon_key_here"

# The privileged service-role key (Backend only, never expose to frontend!)
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"


# --- CONFIGURATION (Optional, defaults provided) ---
# NODE_ENV="development"
# PORT=4000
# WEB_ORIGINS="http://localhost:8081,http://localhost:4000"
# MAX_ROOM_CAPACITY=250
# GLOBAL_RATE_LIMIT_PER_MINUTE=120
# MAINTENANCE_MODE=false


# --- OPTIONAL CAPABILITIES ---
# Redis caching (Phase 2+)
# REDIS_URL="redis://localhost:6379"

# LiveKit WebRTC Cloud (https://cloud.livekit.io)
# Copy WebSocket URL from Settings/General, and API Key/Secret from API Keys
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="APIdBFxxxxxxxxx"
LIVEKIT_API_SECRET="your_livekit_api_secret_here"

# Firebase Expo Push (Phase 2+)
# EXPO_PUSH_ACCESS_TOKEN="your_token"

# AI Provider (Phase 2+)
# AI_PROVIDER_URL=""
# AI_PROVIDER_API_KEY=""

# --- WEBRTC & CLOUDFLARE TURN ---
P2P_CALLS_ENABLED=true
CLOUDFLARE_TURN_ENABLED=false
CLOUDFLARE_TURN_KEY_ID=""
CLOUDFLARE_TURN_API_TOKEN=""
TURN_CREDENTIAL_TTL_SECONDS=3600
CALL_RING_TIMEOUT_SECONDS=40
CALL_MAX_RECONNECT_ATTEMPTS=3

