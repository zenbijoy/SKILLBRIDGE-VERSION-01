{
  "name": "skillbridge-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --require ../scripts/node-userinfo-shim.cjs ./node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --require ../scripts/node-userinfo-shim.cjs --require ../scripts/test-setup.cjs ./node_modules/tsx/dist/cli.mjs --test src/**/*.test.ts",
    "test:coverage": "node --require ../scripts/node-userinfo-shim.cjs --require ../scripts/test-setup.cjs ./node_modules/tsx/dist/cli.mjs --test --experimental-test-coverage src/**/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "compression": "1.8.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "livekit-server-sdk": "2.18.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "socket.io": "4.8.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.4.0",
    "@types/supertest": "7.2.1",
    "eslint": "^10.9.1",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
