# -----------------------------------------------------------------------------
# SkillBridge Frontend Environment Example
# DO NOT ADD REAL SECRETS HERE.
# Copy to `.env` and fill in the values.
# -----------------------------------------------------------------------------

# Your Supabase Project URL (must match backend)
EXPO_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# The anonymous public key (safe to commit — it is a publishable key)
EXPO_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_here"

# The backend API base URL
# Production (Render):   https://skillbridge-api.onrender.com/api/v1
# Local dev only:        http://localhost:4000/api/v1  (never use in production)
EXPO_PUBLIC_API_URL="https://skillbridge-api.onrender.com/api/v1"
