# -----------------------------------------------------------------------------
# SkillBridge Frontend Environment Example
# DO NOT ADD REAL SECRETS HERE. 
# Copy to `.env` and fill in the values.
# -----------------------------------------------------------------------------

# Your Supabase Project URL (must match backend)
EXPO_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"

# The anonymous public key
EXPO_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_here"

# The backend API URL
# For Web/Simulator: http://localhost:4000/api/v1
# For Physical Android device: http://<YOUR_PC_LOCAL_IP>:4000/api/v1
EXPO_PUBLIC_API_URL="http://localhost:4000/api/v1"
