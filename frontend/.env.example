# -----------------------------------------------------------------------------
# SkillBridge Frontend Environment Example
# DO NOT ADD REAL SECRETS HERE.
# Copy to `.env` and fill in the values.
# -----------------------------------------------------------------------------

# Your Supabase Project URL (must match backend)
EXPO_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# The anonymous public key (safe to commit — it is a publishable key)
EXPO_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_here"

# The backend API base URL
# Production (Render):   https://skillbridge-api-pd9c.onrender.com/api/v1
# Local dev only:        http://localhost:4000/api/v1  (never use in production)
EXPO_PUBLIC_API_URL="https://skillbridge-api-pd9c.onrender.com/api/v1"

# Google Sign-In Web Client ID (from Google Cloud Console, required for native Google Sign-In)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="your_google_web_client_id.apps.googleusercontent.com"
# Optional iOS-specific Client ID
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID="your_google_ios_client_id.apps.googleusercontent.com"
