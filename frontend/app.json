{
  "expo": {
    "name": "SkillBridge",
    "slug": "skillbridge",
    "scheme": "skillbridge",
    "version": "2.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skillbridge.app",
      "bundleVersion": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "SkillBridge requires camera access so you can participate in live peer learning rooms and video classes.",
        "NSMicrophoneUsageDescription": "SkillBridge requires microphone access to let you speak in live audio and video learning sessions."
      }
    },
    "android": {
      "package": "com.skillbridge.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#08101E"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH",
        "INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "extraGradleProperties": {
              "org.gradle.jvmargs": "-Xmx4g -XX:MaxMetaspaceSize=1024m -XX:+HeapDumpOnOutOfMemoryError"
            }
          }
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "@livekit/react-native-expo-plugin",
        {
          "cameraPermission": "Allow SkillBridge to use your camera for classes.",
          "microphonePermission": "Allow SkillBridge to use your microphone for classes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://skillbridge-api-pd9c.onrender.com/api/v1",
      "router": {},
      "eas": {
        "projectId": "0fb7ccd3-897e-4e93-8da7-7fa7b4c222bc"
      }
    },
    "owner": "bijoysaha"
  }
}
